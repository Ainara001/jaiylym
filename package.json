{
  "name": "jaiylym",
  "version": "1.0.0",
  "private": true,
  "description": "Jaiylym — пастбища села по спутнику: сайт и Telegram-бот",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "test": "node --test tests/*.test.js",
    "bot-dialog": "node bot.js --test",
