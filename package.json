    "test:net": "node --test tests/net/*.net.js",
    "test:e2e": "node --test tests/e2e/*.e2e.js",
    "report": "node report.js",
    "live-check": "node scripts/live-check.js"
  },
  "engines": {
    "node": ">=20.12"
  }
}
